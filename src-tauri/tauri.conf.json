{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tpt-monitor",
  "version": "0.1.0",
  "identifier": "com.tptsolutions.tptmonitor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tpt-monitor",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "TPT Solutions",
    "copyright": "Copyright (c) 2026 TPT Solutions",
    "license": "MIT OR Apache-2.0",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
